// Cloudflare Workers with static assets: Graham's review mirror of `main`,
// built by Workers Builds on every push (other branches get previews).
// Netlify stays what she sees; see CLAUDE.md. `npm run deploy:cloudflare`
// deploys by hand. Static build only; no Worker code, so no `main` key
// and no @astrojs/cloudflare.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ev-research",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist"
  },
  // Required, even empty, for Previews: the per-branch deploys that Workers
  // Builds makes for non-production branches, and `wrangler preview` by hand.
  "previews": {}
}
