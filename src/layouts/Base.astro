---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

// `wide` lifts main's width cap, for a page whose table should take the room it needs.
interface Props { title: string; wide?: boolean }
const { title, wide = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif&display=swap"
    />
  </head>
  <body>
    <Nav />
    <main class:list={[{ wide }]}>
      <slot />
    </main>
  </body>
</html>
