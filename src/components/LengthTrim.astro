---
// A two-handled trim on the size track: pull either end in to narrow the lengths the table shows.
// Two native range inputs share the track, so it works from the keyboard. It sits on the header's
// bottom rule, on the same scale as the dots below. src/scripts/filter-table.js reads it.
import { sizeScale } from '../lib/compare.js';

const STEP = 0.5;
---
<div class="trim" data-trim data-min-gap="2">
  <span class="rail" aria-hidden="true"><span class="fill"></span></span>
  <input type="range" min={sizeScale.lo} max={sizeScale.hi} step={STEP} value={sizeScale.lo} aria-label="Shortest length shown, in inches" />
  <input type="range" min={sizeScale.lo} max={sizeScale.hi} step={STEP} value={sizeScale.hi} aria-label="Longest length shown, in inches" />
</div>

<style>
  /* Placed over the host's track: same inset and width, centred on the header's bottom rule. */
  .trim {
    --thumb-w: 0.625rem;
    --lo: 0%;
    --hi: 100%;
    position: absolute;
    left: var(--track-gap, 0);
    width: var(--track-w);
    bottom: -1px;
    height: 0;
    z-index: 1;
  }

  /* The rail replaces the header rule along the track: faint where trimmed away, ink where kept. */
  .rail { position: absolute; left: 0; right: 0; top: -1px; height: 3px; background: var(--rule); }
  .fill { position: absolute; top: 0; bottom: 0; left: var(--lo); right: calc(100% - var(--hi)); background: var(--ink); }

  /* A native thumb's centre stops half a thumb short of each end, so the inputs overhang the track by
     that much and a value lands exactly where the same length sits on the rows below. */
  input {
    appearance: none;
    -webkit-appearance: none;
    position: absolute;
    top: -0.75rem;
    left: calc(var(--thumb-w) / -2);
    width: calc(100% + var(--thumb-w));
    height: 1.5rem;
    margin: 0;
    padding: 0;
    background: transparent;
    pointer-events: none; /* only the thumbs take the pointer, so both handles stay reachable */
  }
  input::-webkit-slider-runnable-track { background: transparent; height: 1.5rem; }
  input::-moz-range-track { background: transparent; height: 1.5rem; }

  input::-webkit-slider-thumb {
    -webkit-appearance: none;
    pointer-events: auto;
    width: var(--thumb-w);
    height: 1.25rem;
    margin-top: 0.125rem;
    border: 0;
    border-radius: 0.2rem;
    background: var(--ink);
    box-shadow: 0 0 0 2px var(--paper);
    cursor: ew-resize;
  }
  input::-moz-range-thumb {
    pointer-events: auto;
    width: var(--thumb-w);
    height: 1.25rem;
    border: 0;
    border-radius: 0.2rem;
    background: var(--ink);
    box-shadow: 0 0 0 2px var(--paper);
    cursor: ew-resize;
  }
  input:focus-visible { outline: none; }
  input:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--pass); }
  input:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--pass); }
</style>
