---
// Page two's table: one row per model that passes both gates, on shared size and range tracks, with
// its "Sort by" control and its filters: a length trim on the size track and a Hide box per row, both
// remembered in the browser. Model names link to their one-sheet. Every column group has a box under
// "Show"; Tesla plug and On the web (the outbound buttons) start closed.
//
// The head has two tiers: group labels (Size, Range, Reviews), each underlined as wide as its columns,
// over plain column labels. Every column under one group label shares a band, and the open groups'
// bands alternate. A value's unit sits under it in the cell, so no heading has to explain its column.
import SizeTrack from './SizeTrack.astro';
import LengthTrim from './LengthTrim.astro';
import RangeTrack from './RangeTrack.astro';
import OutLinks from './OutLinks.astro';
import RatingCell from './RatingCell.astro';
import { rows, rangeText } from '../lib/compare.js';
import { sheetHref } from '../lib/links.js';
---
<div class="compare-wrap" data-filterable data-bands="size price">
<div class="controls">
<div class="pickers">
<fieldset class="sort">
  <legend>Sort by</legend>
  <span class="seg">
    <label><input type="radio" name="sort" value="length" data-dir="ascending" checked /> Length</label>
    <label><input type="radio" name="sort" value="range" data-dir="descending" /> Range</label>
    <label><input type="radio" name="sort" value="price" data-dir="ascending" /> Price</label>
    <label><input type="radio" name="sort" value="alpha" data-dir="ascending" /> A–Z</label>
  </span>
</fieldset>

<!-- One box per column group, in column order: scripts/filter-table.js bands every other open one. -->
<fieldset class="cols">
  <legend>Show</legend>
  <label><input type="checkbox" data-col="size" checked /> Size</label>
  <label><input type="checkbox" data-col="plug" /> Tesla plug</label>
  <label><input type="checkbox" data-col="range" checked /> Range</label>
  <label><input type="checkbox" data-col="price" checked /> Price</label>
  <label><input type="checkbox" data-col="reviews" checked /> Reviews</label>
  <label><input type="checkbox" data-col="web" /> On the web</label>
</fieldset>
</div>

<p class="status" data-filter-status aria-live="polite">
  <span data-count></span>
  <span class="part" data-trimmed hidden><span data-trim-text></span> long</span>
  <span class="part" data-hidden-part hidden>
    <span data-hidden-count></span> hidden
    <button type="button" data-toggle-hidden aria-pressed="false">Show them</button>
  </span>
  <button type="button" class="reset" data-reset hidden>Reset</button>
</p>
</div>

<div class="scroll">
  <table class="compare">
    <thead>
      <tr class="groups">
        <td></td>
        <th scope="colgroup" colspan="3" class="g-size">Size <span class="cap">drag the ends of the bar to trim</span></th>
        <th scope="col" class="plug g-plug">Tesla plug</th>
        <th scope="col" class="g-range">Range <span class="cap">EPA, cheapest AWD version</span></th>
        <th scope="col" class="g-price">Price <span class="cap">cheapest AWD version, new</span></th>
        <th scope="colgroup" colspan="2" class="g-reviews">Reviews <span class="cap">out of 10</span></th>
        <th scope="col" class="out-col g-web">On the web <span class="cap">opens a new tab</span></th>
        <td></td>
      </tr>
      <tr class="heads">
        <th scope="col" class="model">Model</th>
        <th scope="col" class="length g-size">
          <span class="sr-only">Length, on a track</span>
          <SizeTrack head />
          <LengthTrim />
        </th>
        <th scope="col" class="len g-size">Length</th>
        <th scope="col" class="width g-size g-end">Width</th>
        <td class="plug g-plug g-end"></td>
        <td class="range g-range g-end"><RangeTrack head /></td>
        <td class="price g-price g-end"></td>
        <th scope="col" class="rating g-reviews">Car and Driver</th>
        <th scope="col" class="rating g-reviews g-end">MotorTrend, within its class</th>
        <td class="out-col g-web g-end"></td>
        <th scope="col" class="hide">Hide</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-slug={r.slug} data-alpha={r.alpha} data-length={r.length ?? 1e9} data-range={r.range ? r.range.max : -1} data-price={r.price ? r.price.value : 1e9}>
          <th scope="row" class="model">
            <a class="name" href={sheetHref(r.slug)}>{r.name}</a>
            {r.year && <span class="year">{r.year}</span>}
          </th>

          <td class="length g-size"><SizeTrack length={r.length} /></td>

          <td class="len g-size">
            {r.length != null
              ? <><span class="num">{r.length}</span><span class="unit">inches</span></>
              : <span class="none">—<span class="sr-only">No data</span></span>}
          </td>

          <td class="width g-size g-end">
            {r.widthDelta != null && r.widthDelta !== 0 && (
              <>
                <span class="num">{Math.abs(r.widthDelta).toFixed(1)}</span>
                <span class="unit">inches {r.widthDelta > 0 ? 'wider' : 'narrower'}</span>
              </>
            )}
            {r.widthDelta === 0 && <span class="unit">same width</span>}
            {r.widthNote && <span class="unit wrap">{r.widthNote}</span>}
            {r.widthDelta == null && !r.widthNote && <span class="none">—<span class="sr-only">No data</span></span>}
          </td>

          <td class="plug g-plug g-end">
            {r.plug
              ? <>{r.plug.text}{r.plug.note && <span class="sub">{r.plug.note}</span>}</>
              : <span class="none">—<span class="sr-only">No data</span></span>}
          </td>

          <td class="range g-range g-end">
            <RangeTrack range={r.range} />
            {r.range
              ? <>
                  <span class="num">{rangeText(r.range)}{r.range.estimate && <><span aria-hidden="true">*</span><span class="sr-only"> (maker's estimate)</span></>}</span>
                  <span class="unit">{r.range.spread ? 'miles, all AWD versions' : 'miles'}</span>
                </>
              : <span class="none">—<span class="sr-only">No data</span></span>}
          </td>

          <td class="price g-price g-end">
            {r.price
              ? <><span class="num">{r.price.text}</span><span class="unit">{r.price.trim}</span></>
              : <span class="none">—<span class="sr-only">No data</span></span>}
          </td>

          <td class="rating g-reviews"><RatingCell rating={r.cd} site="Car and Driver" id={`cd-${r.slug}`} /></td>
          <td class="rating g-reviews g-end"><RatingCell rating={r.mt} site="MotorTrend" id={`mt-${r.slug}`} /></td>

          <td class="out-col g-web g-end"><OutLinks links={r.out} stacked /></td>

          <td class="hide">
            <label><input type="checkbox" data-hide /><span class="sr-only">Hide {r.name}</span></label>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
</div>

<script>
  import { sortRows } from '../scripts/sort-table.js';
  import { filterable } from '../scripts/filter-table.js';
  document.querySelectorAll('[data-filterable]').forEach((root) => filterable(root));

  const body = document.querySelector('table.compare tbody');
  document.querySelectorAll<HTMLInputElement>('.sort input').forEach((input) => {
    input.addEventListener('change', () => sortRows(body, input.value, input.dataset.dir));
  });
</script>

<style>
  /* The toolbar: a ruled band over the table, pickers at the left and the filter status at the right.
     The segments and the Reset button are the same height, so the band never jumps. */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 2.5rem;
    margin: 0 0 0.5rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  /* Filter status: what's showing, what's been hidden, and the way back. */
  .status { margin: 0; font-size: 0.875rem; color: var(--muted); }
  .status .part::before { content: '·'; margin: 0 0.5em 0 0.25em; }
  .status button {
    all: unset;
    cursor: pointer;
    margin-left: 0.35em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .status button[hidden] { display: none; } /* `all: unset` above would otherwise undo the attribute */
  .status button:hover { text-decoration-color: var(--ink); }
  .status button:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .status .reset { margin-left: 1rem; padding: 0.28rem 0.85rem; border: 1px solid var(--ink); text-decoration: none; }
  .status .reset:hover { background: var(--ink); color: var(--paper); }

  .pickers { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 2.75rem; }

  .sort, .cols {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 0;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }
  /* Set like the group labels below, so the band reads as part of the table. */
  .sort legend, .cols legend {
    float: left;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .sort label, .cols label { cursor: pointer; color: var(--muted); }
  .sort label:hover, .cols label:hover { color: var(--ink); }

  /* Sort picks one: joined segments, the chosen one filled. */
  .seg { display: inline-flex; border: 1px solid var(--ink); }
  .seg label { padding: 0.28rem 0.85rem; }
  .seg label + label { border-left: 1px solid var(--ink); }
  .seg label:hover { background: color-mix(in srgb, var(--rule) 35%, transparent); }
  .seg input { position: absolute; opacity: 0; pointer-events: none; }
  .seg label:has(input:checked) { background: var(--ink); color: var(--paper); }
  .seg label:has(input:focus-visible) { outline: 2px solid var(--pass); outline-offset: 2px; }

  /* Show ticks any: boxes, like the Hide column's. */
  .cols label { display: inline-flex; align-items: center; gap: 0.45rem; }
  .cols input { width: 1rem; height: 1rem; margin: 0; accent-color: var(--ink); cursor: pointer; }
  .cols label:has(input:checked) { color: var(--ink); }

  /* The table is as wide as its columns need, and the controls above end where it ends. Nothing caps
     it (the page is `wide`); only a window narrower than the table scrolls it. */
  .compare-wrap { width: fit-content; max-width: 100%; }
  .scroll { overflow-x: auto; }

  .compare {
    --size-w: 10rem;
    --range-w: 10rem;
    --track-gap: 1rem;
    --track-head-h: 2.25rem; /* the track labels, down to the head's bottom rule */
    --group-gap: 0.75rem; /* between one group's underline and band and the next's */
    --band: color-mix(in srgb, var(--rule) 22%, transparent);
    --band-solid: color-mix(in srgb, var(--rule) 22%, var(--paper)); /* the same tint, opaque */
    border-collapse: collapse;
  }
  .compare th, .compare td {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: middle;
  }
  .compare th:first-child { padding-left: 0; }

  /* Head, tier one: the group labels. Each underline stops a gap short of the next group. */
  .compare .groups th, .compare .groups td { padding: 0.85rem 0.75rem 0.4rem; border-bottom: 0; vertical-align: bottom; }
  .compare .groups th {
    background: linear-gradient(var(--ink), var(--ink)) no-repeat left bottom / calc(100% - var(--group-gap)) 1px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .compare .groups :is(.g-size, .g-range) { padding-left: var(--track-gap); } /* level with the track below */
  .cap { margin-left: 0.5rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--muted); }

  /* Head, tier two: plain column labels over the ink rule. The track strips stand on the rule, their
     labels level with the column labels. */
  .compare .heads th, .compare .heads td {
    height: 2.75rem;
    padding: 0.5rem 0.75rem 0;
    border-bottom-color: var(--ink);
    vertical-align: top;
    font-size: 0.75rem;
    font-weight: 400;
    white-space: nowrap;
    color: var(--muted);
  }
  .compare .heads .model { padding-left: 0; }

  /* A group shows while its "Show" box is ticked (scripts/filter-table.js remembers which). */
  .compare-wrap:has([data-col='size']:not(:checked)) .compare .g-size,
  .compare-wrap:has([data-col='plug']:not(:checked)) .compare .g-plug,
  .compare-wrap:has([data-col='range']:not(:checked)) .compare .g-range,
  .compare-wrap:has([data-col='price']:not(:checked)) .compare .g-price,
  .compare-wrap:has([data-col='reviews']:not(:checked)) .compare .g-reviews,
  .compare-wrap:has([data-col='web']:not(:checked)) .compare .g-web { display: none; }

  /* Bands: every column under one group label shares a tint as wide as the label's underline, and the
     open groups alternate, the first one banded. Which ones those are is data-bands, from the script. */
  .compare-wrap[data-bands~='size'] .compare :is(.heads, tbody) .g-size,
  .compare-wrap[data-bands~='plug'] .compare :is(.heads, tbody) .g-plug,
  .compare-wrap[data-bands~='range'] .compare :is(.heads, tbody) .g-range,
  .compare-wrap[data-bands~='price'] .compare :is(.heads, tbody) .g-price,
  .compare-wrap[data-bands~='reviews'] .compare :is(.heads, tbody) .g-reviews,
  .compare-wrap[data-bands~='web'] .compare :is(.heads, tbody) .g-web {
    background: linear-gradient(var(--band), var(--band)) no-repeat left top / var(--band-w, 100%) 100%;
    --track-bg: var(--band-solid);
    --track-tick: color-mix(in srgb, var(--muted) 30%, transparent);
    --info-edge: color-mix(in srgb, var(--muted) 45%, transparent);
  }
  .compare .g-end { --band-w: calc(100% - var(--group-gap)); }

  /* Model */
  .model .name { display: block; font-weight: 700; text-decoration-color: var(--rule); }
  .model .name:hover { text-decoration-color: var(--ink); }
  .model .year { font-family: var(--font-data); font-size: 0.8125rem; color: var(--muted); }
  tbody th.model { font-weight: 400; min-width: 12rem; }
  .model .name { text-wrap: balance; } /* a long name breaks evenly rather than widening the column */

  /* A value, and under it its unit, set like the column labels. */
  .num { display: block; font-family: var(--font-data); font-size: 0.875rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .unit { display: block; font-size: 0.75rem; white-space: nowrap; color: var(--muted); }
  .unit.wrap { min-width: 6rem; white-space: normal; } /* a width given with mirrors: words, no number */
  .sub { display: block; font-size: 0.8125rem; color: var(--muted); }
  .none { color: var(--muted); }

  td.plug { font-size: 0.9375rem; }

  /* Track hosts (styles/tracks.css). The length track has a column to itself, as wide as the track;
     the range track sits to the left inside its cell, with the printed values to its right. */
  .length, .range { position: relative; }
  .length { --track-w: var(--size-w); }
  .range { --track-w: var(--range-w); }
  .compare th.length, .compare td.length { min-width: calc(var(--size-w) + var(--track-gap) * 2); }
  .compare td.range { padding-left: calc(var(--range-w) + var(--track-gap) * 2); }

  /* Ratings: the score for the row's own model year; other years sit behind the info button. */
  .compare th.rating { min-width: 8.5rem; }
  .compare td.rating { overflow: visible; }

  /* On the web: three stacked buttons, the column as wide as the longest label. */
  .compare td.out-col { white-space: nowrap; }
  .compare tbody td.out-col { padding-top: 0.6rem; padding-bottom: 0.6rem; }

  /* Hide: a box per row. A hidden row leaves the table; "Show them" brings hidden rows back dimmed,
     boxes still ticked, so one can be unticked. */
  .compare th.hide, .compare td.hide { width: 3rem; padding-right: 0; text-align: center; }
  .hide label { display: inline-flex; padding: 0.5rem; cursor: pointer; }
  .hide input { width: 1rem; height: 1rem; margin: 0; accent-color: var(--ink); cursor: pointer; }
  tbody tr.is-hidden > :not(.hide) { opacity: 0.4; }

  tbody tr:hover { background: color-mix(in srgb, var(--rule) 22%, transparent); }
</style>
