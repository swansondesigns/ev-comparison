---
// The top of every page: an optional kicker, the title, an optional line tight under it, then whatever
// the page puts beneath. The kicker sits in the padding above the title, so the title lands at the
// same height on every page, with or without one.
interface Props { title: string; kicker?: string; sub?: string }
const { title, kicker, sub } = Astro.props;
---
<header class="page-head">
  {kicker && <p class="kicker">{kicker}</p>}
  <h1>{title}</h1>
  {sub && <p class="sub">{sub}</p>}
  <slot />
</header>

<style>
  .page-head { position: relative; padding-top: 3.5rem; margin: 0 0 1.75rem; }
  .kicker {
    position: absolute;
    top: 2rem;
    left: 0;
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 { margin: 0 0 1.25rem; }
  h1:has(+ .sub) { margin-bottom: 0.25rem; }
  .sub { margin: 0 0 1.25rem; font-family: var(--font-data); font-size: 0.875rem; color: var(--muted); }
</style>
