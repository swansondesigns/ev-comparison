---
// Page two: side by side for the models that pass both gates. A thin page: it arranges components
// and holds the copy.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Section from '../components/Section.astro';
import CompareTable from '../components/CompareTable.astro';
import { rows } from '../lib/compare.js';

const anyEstimate = rows.some((r) => r.range?.estimate);
---
<Base title="Side by side" wide>
  <PageHead title="Side by side">
    <dl class="key">
      <div><dt><span class="line line-corolla" aria-hidden="true"></span>Dashed line</dt><dd>your car, the Corolla</dd></div>
      <div><dt><span class="line line-feels-right" aria-hidden="true"></span>Solid line</dt><dd>the Mach-E, the one you said feels right</dd></div>
    </dl>
  </PageHead>

  <Section>
    <CompareTable />
    {anyEstimate && (
      <p slot="note"><span aria-hidden="true">*</span> Hollow bar: the maker's EPA estimate. EPA hasn't listed that model yet.</p>
    )}
  </Section>
</Base>

<style>
  .line { display: inline-block; height: 0.9em; margin-right: 0.45em; vertical-align: -0.1em; }
  .line-corolla { border-left: 1.5px dashed var(--muted); }
  .line-feels-right { border-left: 1.5px solid var(--pass); }
</style>
