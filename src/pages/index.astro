---
// Page one: go/no-go for every model checked, including the bZ itself. Marks only; no numbers here.
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { models, byMakeModel } from '../lib/data.js';

// Sort values for the gate columns: passes first when ascending, no-data between pass and fail.
const rank = { pass: 0, '?': 1, fail: 2 };
const rows = [...models].sort(byMakeModel);
---
<Base title="Every car we checked">
  <h1>Every car we checked</h1>

  <p class="note">Every car here can use Tesla Superchargers.</p>
  <dl class="key">
    <div><dt>Size</dt><dd>shorter than the Toyota bZ</dd></div>
    <div><dt>AWD</dt><dd>offered on at least one trim</dd></div>
  </dl>

  <table class="gonogo">
    <thead>
      <tr>
        <th scope="col" data-sort="alpha" aria-sort="ascending"><button type="button">Model</button></th>
        <th scope="col" data-sort="size"><button type="button">Size</button></th>
        <th scope="col" data-sort="awd"><button type="button">AWD</button></th>
      </tr>
    </thead>
    <tbody>
      {rows.map((m, i) => (
        <tr class:list={{ pass: m.pass }} data-alpha={i} data-size={rank[m.gates.size]} data-awd={rank[m.gates.awd]}>
          <th scope="row">{m.name}</th>
          <td><Mark state={m.gates.size} /></td>
          <td><Mark state={m.gates.awd} /></td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>

<script>
  import { sortable } from '../scripts/sort-table.js';
  sortable(document.querySelector('table.gonogo'));
</script>

<style>
  h1 { margin-top: 3rem; }

  .note { margin: 0 0 0.5rem; }

  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0 0 2rem;
    color: var(--muted);
  }
  .key div { display: flex; gap: 0.4em; }
  .key dt { font-weight: 700; color: var(--ink); }
  .key dd { margin: 0; }

  .gonogo {
    border-collapse: collapse;
    width: 100%;
    max-width: 34rem;
  }
  .gonogo th, .gonogo td {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
  }
  .gonogo th:first-child, .gonogo td:first-child { padding-left: 0; }
  .gonogo thead th {
    position: sticky;
    top: 0;
    background: var(--paper);
    border-bottom-color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gonogo thead th:not(:first-child), .gonogo td { width: 5.5rem; text-align: center; }
  .gonogo tbody th { font-weight: 400; }
  .gonogo tr.pass th { font-weight: 700; }
  .gonogo tbody tr:hover { background: color-mix(in srgb, var(--rule) 22%, transparent); }
</style>
