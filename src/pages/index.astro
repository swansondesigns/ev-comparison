---
// Page one: go/no-go for every model checked. A thin page: it arranges components and holds the copy.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import GateTable from '../components/GateTable.astro';
import { models, byMakeModel } from '../lib/data.js';

const rows = [...models].sort(byMakeModel);
---
<Base title="Every car we checked">
  <h1>Every car we checked</h1>

  <p class="note">Every car here comes from compact and subcompact electric SUV lists.</p>
  <dl class="key">
    <div><dt>AWD</dt><dd>offered on at least one trim</dd></div>
    <div><dt>Tesla</dt><dd>can charge at Tesla Superchargers today, with a built-in port or an adapter</dd></div>
  </dl>

  <Section>
    <GateTable rows={rows} />
  </Section>
</Base>

<style>
  h1 { margin-top: 3rem; }

  .note { margin: 0 0 0.5rem; }

  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0 0 2rem;
    color: var(--muted);
  }
  .key div { display: flex; gap: 0.4em; }
  .key dt { font-weight: 700; color: var(--ink); }
  .key dd { margin: 0; }
</style>
